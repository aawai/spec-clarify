{
  "name": "spec-clarify",
  "version": "0.1.8",
  "description": "把审核意见逐条交给产品方澄清并保留完整记录的自托管站点",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aawai/spec-clarify.git"
  },
  "bin": {
    "spec-clarify": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "dev": "tsx src/cli.ts serve --config examples/basic/spec-clarify.config.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@heroui/styles": "^3.2.7",
    "@hono/node-server": "^2.1.6",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.16",
    "markdown-it": "^14.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
